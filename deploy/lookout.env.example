# /etc/lookout.env (root:root, mode 600): read by lookout.service.
NIGHTSCOUT_HOST=https://YOUR-NIGHTSCOUT.example.com
API_SECRET=your-nightscout-api-secret
# Fleet collector (deploy/README.md):
#  --openaps        a directory the Lookout user can read; it need not exist
#                   (the default /root/myopenaps is unreadable for a non-root user)
#  --display_type watch   the G7's WATCH slot (3). Never use --force_medical_slot:
#                   slot 1 is the pump's (e.g. Omnipod 5). g7-rig refuses it.
#  --no_xdripaps    no local OpenAPS xDripAPS server on this device
#  --no_auto_pair   pair only when `g7-rig pair` asks; otherwise use the shared key
#  --no_reboot      never reboot after failed reads (the wearer is near another collector)
# g7-rig pair / import-key add --no_auto_pair, --no_reboot and --display_type
# watch if missing, and remove any --sensor_address pin.
# Standalone rig (pairs by itself, `lookout id <code>`): leave out --no_auto_pair
# and --no_reboot; --sensor_address AA:BB:CC:DD:EE:FF pins it to one sensor.
LOOKOUT_ARGS=--openaps /home/pi/myopenaps --display_type watch --no_xdripaps --no_auto_pair --no_reboot
