# /etc/lookout.env (root:root, mode 600): read by lookout.service.
NIGHTSCOUT_HOST=https://YOUR-NIGHTSCOUT.example.com
API_SECRET=your-nightscout-api-secret
# Dexcom G7 on the WATCH slot (3). Never use --force_medical_slot: slot 1 is
# the pump's (e.g. Omnipod 5). Lookout pairs with the sensor that accepts the
# code and from then on connects only to that one. Optionally, add
# --sensor_address AA:BB:CC:DD:EE:FF to pin it to one sensor even before pairing.
LOOKOUT_ARGS=--openaps /home/pi/myopenaps --display_type watch --no_xdripaps
